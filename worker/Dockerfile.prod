# =============================================================================
# Production Dockerfile for Verdict Engine Worker (BullMQ + Sandbox Engine)
# CRITICAL: Includes Docker CLI to control host Docker socket for C++ sandboxes
# =============================================================================

# Stage 1: Build & Compile TypeScript
FROM node:20-slim AS builder
WORKDIR /app

# Install OpenSSL for Prisma client generation
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

# Copy dependency manifests
COPY package*.json ./
COPY prisma ./prisma/

# Install full dependencies
RUN npm ci

# Copy TypeScript configuration and source code
COPY tsconfig.json ./
COPY src ./src

# Generate Prisma Client and build compiled JavaScript
RUN npx prisma generate --schema=prisma/schema.prisma && npm run build

# -----------------------------------------------------------------------------
# Stage 2: Production Runtime with Docker CLI
# -----------------------------------------------------------------------------
FROM node:20-slim AS runner
WORKDIR /app

# CRITICAL: Install Docker CLI (docker.io) and OpenSSL
# This allows the worker to execute 'docker run' commands against the host's daemon
RUN apt-get update && apt-get install -y --no-install-recommends \
    docker.io \
    openssl \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production

# Copy dependency manifests
COPY package*.json ./
COPY prisma ./prisma/

# Install production dependencies and generate Prisma client
RUN npm ci --only=production && npx prisma generate --schema=prisma/schema.prisma

# Copy compiled JavaScript output from builder stage
COPY --from=builder /app/dist ./dist

# Create default sandboxes directory
RUN mkdir -p /app/.temp/sandboxes && chmod 777 /app/.temp/sandboxes

# Start the compiled worker service
CMD ["npm", "run", "start"]


# =============================================================================
# Production Dockerfile for Verdict Engine Frontend (Vite + React + Nginx)
# Multi-stage build: compiles React SPA and serves via lightweight Nginx
# =============================================================================

# Stage 1: Build the React SPA
FROM node:20-alpine AS builder
WORKDIR /app

# Copy dependency manifests
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code and configuration files
COPY tsconfig*.json ./
COPY vite.config.ts ./
COPY tailwind.config.js ./
COPY postcss.config.js ./
COPY index.html ./
COPY src ./src

# Compile TypeScript and bundle static assets
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 2: Serve with Nginx Reverse Proxy
# -----------------------------------------------------------------------------
FROM nginx:1.25-alpine AS runner

# Remove default Nginx welcome page
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration (handles SPA routing and /api reverse proxy)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose standard HTTP port
EXPOSE 80

# Health check for Nginx server
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Start Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]

